[Unit]
Description=Logger v2: spegnimento automatico a bici ferma (poi riaccende l'IMU col movimento)
# NON After=sensor_hub: sensor_hub è After=multi-user.target → ciclo, systemd scarterebbe questo servizio (16/11)
After=imu_wake.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Environment=FERMO_MIN=5 MIN_ACCESO_MIN=3
ExecStart=/usr/bin/python3 /home/asmile-logger/logger_autospegni.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
