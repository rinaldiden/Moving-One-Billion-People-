[Unit]
Description=Asmile sensor_hub: CSV unico 50 Hz di tutti i sensori (t_ms = orologio dei frame camera)
After=multi-user.target data.mount
# __HUB_DIR__ viene sostituito dal deploy (repo su asmile/asmile2, ~/logger sul logger)

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -u __HUB_DIR__/sensor_hub.py
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
