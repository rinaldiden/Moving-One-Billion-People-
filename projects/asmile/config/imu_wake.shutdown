#!/bin/sh
# /usr/lib/systemd/system-shutdown/: gira per ULTIMO, subito prima che il kernel spenga.
# Se mentre si spegne la bici si muove, l'INT resta alto, l'IRF4905 non stacca e il Pi resterebbe fermo
# con la corrente attaccata (sordo ai movimenti). In quel caso riavvia invece di spegnersi.
[ "$1" = "poweroff" ] || exit 0
if ! /usr/bin/python3 /home/asmile-logger/imu_wake.py ultimo; then
    echo "imu_wake: bici in movimento allo spegnimento -> riavvio" > /dev/kmsg
    echo b > /proc/sysrq-trigger
fi
