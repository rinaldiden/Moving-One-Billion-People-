[Unit]
Description=Asmile Safe Shutdown — monitors power loss via GPIO
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/asmile/wip/Moving-One-Billion-People-/projects/asmile/pi/power/safe_shutdown.py
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
User=root

[Install]
WantedBy=multi-user.target
