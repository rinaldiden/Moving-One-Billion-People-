[Unit]
Description=Asmile Power Steering Controller
After=network.target encoder-ssi.service
Requires=encoder-ssi.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /home/asmile/wip/ripristino-test/Moving-One-Billion-People-/projects/asmile/pi/steering/steering_controller.py
WorkingDirectory=/home/asmile/wip/ripristino-test/Moving-One-Billion-People-/projects/asmile/pi/steering
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
