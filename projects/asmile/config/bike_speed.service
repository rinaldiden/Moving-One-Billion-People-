[Unit]
Description=Bike Speed Reader (CooSpo BLE CSC → /tmp/bike_speed)
After=bluetooth.target
Wants=bluetooth.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/%USER%/wip/Moving-One-Billion-People-/projects/asmile/pi/sensors/bike_speed_reader.py
Restart=on-failure
RestartSec=10
User=%USER%

[Install]
WantedBy=multi-user.target
