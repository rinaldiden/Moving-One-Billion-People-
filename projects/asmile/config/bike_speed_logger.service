[Unit]
Description=Sensore velocita ruota BLE (CooSpo BK467) -> /tmp/bike_speed.json, letto dal sensor_hub
After=bluetooth.target
Wants=bluetooth.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -u __HUB_DIR__/bike_speed_ble.py
Restart=always
RestartSec=10
Nice=10
CPUQuota=20%

[Install]
WantedBy=multi-user.target
