# Logger HW3 (Waveshare ESP32-P4-Module-DEV-KIT + OV9281 Inno-Maker) — logger02
CONFIG_CAMERA_OV9281=y
CONFIG_CAMERA_OV9281_MIPI_RAW8_1280X720_50FPS=y
CONFIG_CAMERA_OV9281_MIPI_DEFAULT_FMT_RAW8_1280X720_50FPS=y
# 23/11: si registra a 1280x800 (risoluzione piena, come #001). Il driver parte nel suo modo 720 e logger02_rec.c passa
# al formato main/ov9281_1280x800.h con VIDIOC_S_SENSOR_FMT prima di aprire i buffer.
CONFIG_L02_REC_1280X800=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_EXAMPLE_SELECT_CUSTOMIZED_DEV_BOARD=y
CONFIG_EXAMPLE_MIPI_CSI_SCCB_SCL_PIN=8
CONFIG_EXAMPLE_MIPI_CSI_SCCB_SDA_PIN=7
CONFIG_EXAMPLE_MDNS_HOST_NAME="logger02"
# CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE is not set
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_EXAMPLE_CONNECT_WIFI=y
# CONFIG_EXAMPLE_CONNECT_ETHERNET is not set
# CONFIG_EXAMPLE_CONNECT_IPV6 is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=16384
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_VIDEO_ENABLE_HW_H264_VIDEO_DEVICE=y
CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY=-1
CONFIG_ML_DERP_REGION=4
# RAM interna per il wifi (esp_hosted): il resto in PSRAM (crash per memoria esaurita durante OTA, 17/11)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 18/11: gli algoritmi Espressif (IPA: AGC con target luma 19/255) litigavano con la nostra AE (A decide, B copia).
# Spegnere solo l'AGC faceva crashare all'avvio: spengo tutto il controller della pipeline ISP (niente IPA).
# CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER is not set


# 18/11: crash A "assert sdio_read_task: RX buffer alloc 23040 failed" (RAM interna frammentata): buffer del wifi in PSRAM
# (opzione Espressif pensata per P4 + video). NB: RX_MAX_SIZE invece rompeva il wifi dopo 60 s.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# 26/11: sensore ruota BLE (CooSpo, CSC 0x1816) sulla A: NimBLE sul P4, controller BT sul C6 via esp_hosted (VHCI sull'SDIO
# del wifi). Solo central+observer, una connessione, niente sicurezza/bonding; memoria NimBLE in PSRAM (RAM interna scarsa).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# 27/11: core dump su flash (partizione "coredump") per sapere DOVE crasha (18:18 e 19:10 entrando in deep sleep)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
