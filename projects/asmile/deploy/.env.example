# .env.example — Asmile pipeline environment variables
# Copy this file to /home/asmile/asmile/.env and fill in real values.
# NEVER commit the real .env file to git (it is in .gitignore).
#
# Permissions:  chmod 600 /home/asmile/asmile/.env
#               chown asmile:asmile /home/asmile/asmile/.env

# ---- Telegram notifications (used by notify.sh) ----------------------------
# Create a bot via @BotFather on Telegram to get the token.
# Get the chat ID by messaging your bot and querying:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# ---- GitHub (used by push_session.sh) --------------------------------------
# These are informational — the actual auth uses the SSH deploy key.
GITHUB_OWNER=your-github-org-or-user
GITHUB_REPO=Moving-One-Billion-People-
GITHUB_DATA_BRANCH=data
