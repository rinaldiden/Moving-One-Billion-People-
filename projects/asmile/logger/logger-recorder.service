[Unit]
Description=Asmile logger - registrazione video a segmenti (Camarray -> /data)
# Parte solo quando la partizione dati /data e' montata
RequiresMountsFor=/data
After=multi-user.target

[Service]
Type=exec
User=__USER__
Environment=HOME=/home/__USER__
ExecStart=/home/__USER__/logger/recorder.sh
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
