[Unit]
Description=Asmile logger - streaming MJPEG Camarray (http://IP:8080)
After=multi-user.target

[Service]
Type=simple
User=__USER__
Environment=HOME=/home/__USER__
WorkingDirectory=/home/__USER__/streaming
ExecStart=/usr/bin/python3 /home/__USER__/streaming/stream_logger.py
Restart=on-failure
RestartSec=5
# crash-loop protection
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
