[Unit]
Description=Asmile logger - streaming MJPEG Camarray (http://IP:8080)
After=multi-user.target

[Service]
Type=simple
User=asmile-logger
Environment=HOME=/home/asmile-logger
WorkingDirectory=/home/asmile-logger/streaming
ExecStart=/usr/bin/python3 /home/asmile-logger/streaming/stream_logger.py
Restart=on-failure
RestartSec=5
# crash-loop protection
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
