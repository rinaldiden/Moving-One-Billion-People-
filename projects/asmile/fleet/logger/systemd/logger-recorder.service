[Unit]
Description=Asmile logger - registrazione video a segmenti (Camarray -> /data)
# Parte solo quando la partizione dati /data e' montata
RequiresMountsFor=/data
After=multi-user.target

[Service]
Type=exec
User=asmile-logger
Environment=HOME=/home/asmile-logger
ExecStart=/home/asmile-logger/logger/recorder.sh
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
