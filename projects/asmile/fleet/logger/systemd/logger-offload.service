[Unit]
Description=Asmile logger - offload clip al Mac (Tailscale) con prova checksum + delete
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asmile-logger
Environment=HOME=/home/asmile-logger
ExecStart=/usr/bin/python3 /home/asmile-logger/logger/offload_confirm.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
