{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asmile/perception_pipeline/situations.schema.json",
  "title": "Stadio 3 — output situation (timeline situazioni)",
  "type": "object",
  "required": ["pipeline", "stage", "taxonomy_ref", "situations"],
  "properties": {
    "pipeline": { "const": "asmile-seg" },
    "stage": { "const": "3-situations" },
    "taxonomy_ref": { "const": "knowledge/situation_taxonomy.md", "description": "vocabolario FISSO" },
    "situations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session", "t_start", "t_end", "situation", "confidence", "expected_response"],
        "properties": {
          "session": { "type": "string" },
          "t_start": { "type": "number" },
          "t_end": { "type": "number" },
          "situation": {
            "type": "string",
            "description": "SOLO valori dalla tassonomia; 'unknown' ammesso ed è legittimo"
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "trigger": {
            "type": "object",
            "description": "cosa l'ha fatta scattare",
            "properties": {
              "classes": { "type": "array", "items": { "type": "string" } },
              "sensors": { "type": "object" }
            }
          },
          "expected_response": { "type": "string", "description": "risposta di guida attesa (per reward sim2real)" },
          "case_candidate": { "type": "boolean", "description": "unknown/conflitto → proposto a Daniele" }
        }
      }
    }
  }
}
