{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asmile/perception_pipeline/segmentation.schema.json",
  "title": "Stadio 1 — output segmenter (segmentazione full-coverage)",
  "type": "object",
  "required": ["pipeline", "stage", "corpus_anonymous", "sample_every", "frames"],
  "properties": {
    "pipeline": { "const": "asmile-seg" },
    "stage": { "const": "1-segmentation" },
    "corpus_anonymous": { "type": "boolean", "description": "DEVE essere true: input solo da asmile-anon-*" },
    "sample_every": { "type": "integer", "minimum": 1, "description": "1 frame ogni N" },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame_id", "session", "t", "classes", "drivable"],
        "properties": {
          "frame_id": { "type": "string" },
          "session": { "type": "string" },
          "t": { "type": "number", "description": "secondi dall'inizio sessione" },
          "classes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "confidence", "bbox"],
              "properties": {
                "name": { "type": "string", "description": "da categories.yaml" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
                "mask_ref": { "type": "string", "description": "path locale maschera, opzionale" },
                "distance_m": { "type": ["number", "null"] },
                "depth_quality": { "enum": ["fine", "coarse", "none"] }
              }
            }
          },
          "drivable": {
            "type": "object",
            "description": "aree da categories.yaml (safe/caution/stop/ignore)",
            "properties": {
              "safe_frac": { "type": "number" },
              "caution_frac": { "type": "number" },
              "stop_frac": { "type": "number" },
              "corridor_free_cm": { "type": ["number", "null"] }
            }
          },
          "warmup_skipped": { "type": "boolean" }
        }
      }
    }
  }
}
